        <insert tableName="user">
            <column name="username" value="${adminUsername}"/>
            <column name="salted_password" valueComputed="crypt('${adminPasswordPlain}', gen_salt('bf'))"/>
            <column name="personal_data_id" valueComputed="(SELECT id FROM personal_data WHERE email = 'arbitaja@arbitaja.com')"/>
        </insert>
    </changeSet>

