    <changeSet id="seed-basic-000-enable-pgcrypto" author="heinrich.vannas" context="dev,test">
        <sql>CREATE EXTENSION IF NOT EXISTS pgcrypto;</sql>
    </changeSet>

    <changeSet id="seed-basic-001-permission-basic" author="heinrich.vannas" context="dev,test">
        <insert tableName="permission">
            <column name="key" value="BASIC"/>
            <column name="key_object" value="basic"/>
            <column name="name" value="basic"/>
        </insert>
    </changeSet>

