    <changeSet id="seed-basic-019-competition-noor-meister" author="heinrich.vannas" context="dev,test">
        <insert tableName="competition">
            <column name="name" value="Noor meister"/>
            <column name="scoring_criteria_group_main_id" valueComputed="(SELECT id FROM scoring_groups_structure WHERE name = 'noormeister')"/>
            <column name="start_time" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="end_time" valueComputed="CURRENT_TIMESTAMP + INTERVAL '1 day'"/>
            <column name="organizer_id" valueComputed="(SELECT id FROM &quot;user&quot; WHERE username = '${adminUsername}')"/>
            <column name="score_showtime" valueComputed="CURRENT_TIMESTAMP + INTERVAL '20 hours'"/>
            <column name="publish_scores" valueBoolean="false"/>
        </insert>
    </changeSet>

